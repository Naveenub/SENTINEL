# Required. Gateway refuses to start without them.
SENTINEL_AUDIT_KEY=change-me-32+-random-bytes
SENTINEL_ADMIN_TOKEN=change-me-separate-from-agent-access
# Optional
SENTINEL_POLICY=policies/agents.yaml
SENTINEL_AUDIT_DB=sentinel_audit.db
SENTINEL_LOG_CONTENT=0
# L1 ML backend, "module:Class" with .score(text)->float in [0,1]
# SENTINEL_CLASSIFIER=my_pkg.nemo_backend:NemoJailbreak
SENTINEL_CLASSIFIER_THRESHOLD=0.8
# L3 sandbox
# SENTINEL_SANDBOX_RUNTIME=runsc
# SENTINEL_EGRESS_NETWORK=sentinel-egress
# SENTINEL_EGRESS_PROXY=http://proxy-host:3128
# L5 alerts
# SENTINEL_ALERT_WEBHOOK=https://hooks.example.com/sentinel
# SENTINEL_LEARN_CALLS=50
# SENTINEL_CALL_LIMIT=60
# SENTINEL_DENY_LIMIT=10
# L1 classifier backends (comma-separate to ensemble): nim, prompt_guard, or module:Class
# SENTINEL_CLASSIFIER=nim,prompt_guard
# SENTINEL_CLASSIFIER_ON_ERROR=closed        # closed = block when the classifier fails; open = fall back to rules + alert
# SENTINEL_NIM_URL=http://127.0.0.1:8000     # NemoGuard JailbreakDetect NIM
# SENTINEL_NIM_API_KEY=
# SENTINEL_PG_MODEL=meta-llama/Llama-Prompt-Guard-2-86M   # gated: accept Meta license, set HF_TOKEN
# SENTINEL_PG_DEVICE=                         # e.g. 0 for first GPU
