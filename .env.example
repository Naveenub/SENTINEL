# Required. Gateway refuses to start without them.
SENTINEL_AUDIT_KEY=change-me-32+-random-bytes
SENTINEL_ADMIN_TOKEN=change-me-separate-from-agent-access
# Optional
SENTINEL_POLICY=policies/agents.yaml
SENTINEL_AUDIT_DB=sentinel_audit.db
SENTINEL_LOG_CONTENT=0
# L1 ML backend, "module:Class" with .score(text)->float in [0,1]
# SENTINEL_CLASSIFIER=my_pkg.nemo_backend:NemoJailbreak
SENTINEL_CLASSIFIER_THRESHOLD=0.8
# L3 sandbox
# SENTINEL_SANDBOX_RUNTIME=runsc
# SENTINEL_EGRESS_NETWORK=sentinel-egress
# SENTINEL_EGRESS_PROXY=http://proxy-host:3128
# L5 alerts
# SENTINEL_ALERT_WEBHOOK=https://hooks.example.com/sentinel
# SENTINEL_LEARN_CALLS=50
# SENTINEL_CALL_LIMIT=60
# SENTINEL_DENY_LIMIT=10
# L1 classifier backends (comma-separate to ensemble): nim, prompt_guard, or module:Class
# SENTINEL_CLASSIFIER=nim,prompt_guard
# SENTINEL_CLASSIFIER_ON_ERROR=closed        # closed = block when the classifier fails; open = fall back to rules + alert
# SENTINEL_NIM_URL=http://127.0.0.1:8000     # NemoGuard JailbreakDetect NIM
# SENTINEL_NIM_API_KEY=
# SENTINEL_PG_MODEL=meta-llama/Llama-Prompt-Guard-2-86M   # gated: accept Meta license, set HF_TOKEN
# SENTINEL_PG_DEVICE=                         # e.g. 0 for first GPU

# L2 policy backend: yaml (default) or opa. With opa, YAML still defines each tool's schema/sandbox/secrets;
# OPA decides who may call it (policies/opa/). Startup fails if OPA is unreachable or the policy is not loaded.
# SENTINEL_POLICY_BACKEND=opa
# SENTINEL_OPA_URL=http://127.0.0.1:8181      # opa run --server policies/opa
# SENTINEL_OPA_PATH=sentinel/authz/decision
# SENTINEL_OPA_TIMEOUT=2
# SENTINEL_OPA_TOKEN=
# L4 token revocation
# SENTINEL_REVOKE_DB=                         # defaults to SENTINEL_AUDIT_DB
# SENTINEL_VERIFIER_TOKEN=                    # lets services call /v1/token/verify without the admin token
# Model-traffic proxy (OpenAI-compatible). Mounted only when SENTINEL_UPSTREAM_URL is set.
# SENTINEL_UPSTREAM_URL=https://api.openai.com   # or http://127.0.0.1:8000 (vLLM), :11434 (Ollama), ...
# SENTINEL_UPSTREAM_KEY=                      # held by the gateway; agents never see it
# SENTINEL_UPSTREAM_TIMEOUT=120
# SENTINEL_PROXY_BLOCK_MODE=error             # error = HTTP 403; refusal = 200 content_filter completion (for garak)
# SENTINEL_PROXY_TOOLCALLS=enforce            # preflight model-proposed tool calls against policy; off to skip
# SENTINEL_PROXY_STREAM=buffered              # stream=true: buffer + scan the full reply, then re-emit as SSE; reject = 400
