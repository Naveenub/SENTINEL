# Required. Gateway refuses to start without them.
SENTINEL_AUDIT_KEY=change-me-32+-random-bytes
SENTINEL_ADMIN_TOKEN=change-me-separate-from-agent-access
# Optional
SENTINEL_POLICY=policies/agents.yaml
SENTINEL_AUDIT_DB=sentinel_audit.db
SENTINEL_LOG_CONTENT=0
# L1 ML backend, "module:Class" with .score(text)->float in [0,1]
# SENTINEL_CLASSIFIER=my_pkg.nemo_backend:NemoJailbreak
SENTINEL_CLASSIFIER_THRESHOLD=0.8
# L3 sandbox
# SENTINEL_SANDBOX_RUNTIME=runsc
# SENTINEL_EGRESS_NETWORK=sentinel-egress
# SENTINEL_EGRESS_PROXY=http://proxy-host:3128
# L5 alerts
# SENTINEL_ALERT_WEBHOOK=https://hooks.example.com/sentinel
# SENTINEL_LEARN_CALLS=50
# SENTINEL_LEARN_SECONDS=0                    # >0 = time-based learning period (seconds after an agent's first allowed call); replaces the call count
# SENTINEL_CALL_LIMIT=60
# SENTINEL_DENY_LIMIT=10
# SENTINEL_ALERT_BLOCK=tool_after_blocked_input,output_withheld   # alert rules that quarantine the agent (deny all) instead of only notifying; off when unset
# SENTINEL_QUARANTINE_SECONDS=900             # how long a quarantine lasts (admin can release early)
# SENTINEL_AUTH_ALERT_LIMIT=10               # failed auths per client per 60s before auth_failure_spike fires
# L1 classifier backends (comma-separate to ensemble): nim, prompt_guard, or module:Class
# SENTINEL_CLASSIFIER=nim,prompt_guard
# SENTINEL_CLASSIFIER_ON_ERROR=closed        # closed = block when the classifier fails; open = fall back to rules + alert
# SENTINEL_NIM_URL=http://127.0.0.1:8000     # NemoGuard JailbreakDetect NIM
# SENTINEL_NIM_API_KEY=
# SENTINEL_PG_MODEL=meta-llama/Llama-Prompt-Guard-2-86M   # gated: accept Meta license, set HF_TOKEN
# SENTINEL_PG_DEVICE=                         # e.g. 0 for first GPU

# L2 policy backend: yaml (default) or opa. With opa, YAML still defines each tool's schema/sandbox/secrets;
# OPA decides who may call it (policies/opa/). Startup fails if OPA is unreachable or the policy is not loaded.
# SENTINEL_POLICY_BACKEND=opa
# SENTINEL_OPA_URL=http://127.0.0.1:8181      # opa run --server policies/opa
# SENTINEL_OPA_PATH=sentinel/authz/decision
# SENTINEL_OPA_TIMEOUT=2
# SENTINEL_OPA_TOKEN=
# L4 token revocation
# SENTINEL_REVOKE_DB=                         # defaults to SENTINEL_AUDIT_DB
# SENTINEL_APPROVAL_DB=                       # human-approval records; defaults to SENTINEL_AUDIT_DB
# SENTINEL_APPROVAL_TTL=86400                 # seconds a pending (or decided, unused) approval stays valid
# SENTINEL_APPROVAL_MAX_PENDING=1000          # cap on pending approvals; beyond it new requests are denied
# SENTINEL_LIMITS_DB=                         # per-tool rate-limit counters + auth lockout; defaults to SENTINEL_AUDIT_DB
# SENTINEL_VERIFIER_TOKEN=                    # lets services call /v1/token/verify without the admin token
# Model-traffic proxy (OpenAI-compatible). Mounted only when SENTINEL_UPSTREAM_URL is set.
# SENTINEL_UPSTREAM_URL=https://api.openai.com   # or http://127.0.0.1:8000 (vLLM), :11434 (Ollama), ...
# SENTINEL_UPSTREAM_KEY=                      # held by the gateway; agents never see it
# SENTINEL_UPSTREAM_TIMEOUT=300
# SENTINEL_PROXY_BLOCK_MODE=error             # error = HTTP 403; refusal = 200 content_filter completion (for garak)
# SENTINEL_PROXY_TOOLCALLS=enforce            # preflight model-proposed tool calls against policy; off to skip
# SENTINEL_PROXY_STREAM=buffered              # stream=true: buffer + scan the full reply, then re-emit as SSE; reject = 400

# Optional per-agent auth for /v1/scan, /v1/tool/*, and the model proxy (off when unset). See README section 15.
# SENTINEL_AGENT_TOKENS=research-bot=<16+ chars>,garak-target=<16+ chars>
# SENTINEL_AGENT_TOKENS_FILE=tokens.json      # {"agent": "token" | ["new", {"token": "old", "expires": "2026-12-31T00:00:00Z"}]}; merged with the variable above
# SENTINEL_AGENT_TOKENS=research-bot=<16+ chars>;expires=2026-12-31T00:00:00Z   # env tokens can carry an expiry too
# SENTINEL_REQUIRE_TOKEN_EXPIRY=1             # refuse to start if any agent token (env or file) has no expiry
# SENTINEL_AUTH_MAX_FAILURES=10               # invalid tokens per client within the window before a lockout
# SENTINEL_AUTH_FAILURE_WINDOW=60             # seconds
# SENTINEL_AUTH_LOCKOUT_SECONDS=300           # 429 + Retry-After for this long

# Startup warns when the bind address is non-loopback (best effort; read from --host / UVICORN_HOST).
# SENTINEL_BIND_HOST=                         # declare the real bind address (gunicorn, containers, etc.)
# SENTINEL_ACK_NONLOOPBACK=1                  # silence the warning once auth + TLS (or a private network) are in place

# Built-in TLS launcher: python -m sentinel
# SENTINEL_HOST=127.0.0.1
# SENTINEL_PORT=8080
# SENTINEL_TLS_CERT=/etc/sentinel/cert.pem
# SENTINEL_TLS_KEY=/etc/sentinel/key.pem
# SENTINEL_REQUIRE_TLS=1                      # refuse to start on a non-loopback bind without TLS (ACK does not override)
